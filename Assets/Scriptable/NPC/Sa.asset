    requiredSeason: 0
    startHour: 13
    endHour: 18
    startDate: 0
    quest: {fileID: 0}
    questDurationHours: 0
    dialogueLines:
    - text: "Anh l\xE0m vi\u1EC7c c\u1EA3 ng\xE0y ch\u1EAFc m\u1ECFi tay l\u1EAFm"
      autoProgress: 0
      isInProgressLine: 0
      isCompletedLine: 0
      branchChoice: []
    - text: "L\xE1t ngh\u1EC9 tay qua em ng\u1ED3i m\u1ED9t ch\xFAt nh\xE9."
      autoProgress: 0
      isInProgressLine: 0
      isCompletedLine: 0
      branchChoice: []
  - description: Spring4
    minLevel: 0
    requiredSeason: 0
    startHour: 18
    endHour: 5
    startDate: 0
    quest: {fileID: 0}
    questDurationHours: 0
    dialogueLines:
    - text: "Tr\u1EDDi v\u1EC1 \u0111\xEAm h\u01A1i se l\u1EA1nh, l\xE0ng  m\xECnh
        y\xEAn t\u0129nh \u0111\u1EBFn l\u1EA1."
      autoProgress: 0
      isInProgressLine: 0
      isCompletedLine: 0
      branchChoice: []
  - description: Summer1
    minLevel: 0
    requiredSeason: 1
    startHour: 5
    endHour: 11
    startDate: 0
    quest: {fileID: 0}
    questDurationHours: 0
    dialogueLines:
    - text: "Anh nh\u1EDB u\u1ED1ng nhi\u1EC1u n\u01B0\u1EDBc l\u1ECDc nh\xE9"
      autoProgress: 0
      isInProgressLine: 0
      isCompletedLine: 0
      branchChoice: []
    - text: "\u0110\u1EEBng ch\u1EC9 m\u1EA3i m\xEA c\u1EAFt t\xF3c cho kh\xE1ch."
      autoProgress: 0
      isInProgressLine: 0
      isCompletedLine: 0
      branchChoice: []
  - description: Summer2
    minLevel: 0
    requiredSeason: 1
    startHour: 11
    endHour: 13
    startDate: 0
    quest: {fileID: 0}
    questDurationHours: 0
    dialogueLines:
    - text: "Tr\u1EDDi n\xF3ng nh\u01B0 \u0111\u1ED5 l\u1EEDa,"
      autoProgress: 0
      isInProgressLine: 0
      isCompletedLine: 0
      branchChoice: []
    - text: "Qu\xE1n em h\xF4m nay ch\u1EC9 b\xE1n ch\u1EA1y m\u1ED7i n\u01B0\u1EDBc
        s\u1EA5u \u0111\xE1 th\xF4i."
      autoProgress: 0
      isInProgressLine: 0
      isCompletedLine: 0
      branchChoice: []
  - description: Summer3
    minLevel: 0
    requiredSeason: 1
    startHour: 13
    endHour: 18
    startDate: 0
    quest: {fileID: 0}
    questDurationHours: 0
    dialogueLines:
    - text: "Em \u0111\u1ECBnh t\u1ED1i nay ra b\u1EDD \u0111\xEA h\xF3ng m\xE1t"
      autoProgress: 0
      isInProgressLine: 0
      isCompletedLine: 0
      branchChoice: []
    - text: "Anh c\xF3 mu\u1ED1n... \u0111i c\xF9ng em kh\xF4ng?"
      autoProgress: 0
      isInProgressLine: 0
      isCompletedLine: 0
      branchChoice: []
  - description: Summer4
    minLevel: 0
    requiredSeason: 1
    startHour: 18
    endHour: 5
    startDate: 0
    quest: {fileID: 0}
    questDurationHours: 0
    dialogueLines:
    - text: "Gi\xF3 m\xF9a h\xE8 l\u1ED3ng l\u1ED9ng, ng\u1ED3i ngo\xE0i hi\xEAn
        th\u1EBF n\xE0y th\xEDch th\u1EADt anh \u1EA1."
      autoProgress: 0
      isInProgressLine: 0
      isCompletedLine: 0
      branchChoice: []
  - description: Autumn
    minLevel: 0
    requiredSeason: 2
    startHour: 0
    endHour: 5
    startDate: 0
    quest: {fileID: 0}
    questDurationHours: 0
    dialogueLines:
    - text: "M\u1EB9 em (b\xE0 H\u01B0\u01A1ng) khen anh d\u1EA1o n\xE0y tay ngh\u1EC1
        l\xEAn l\u1EAFm."
      autoProgress: 0
      isInProgressLine: 0
      isCompletedLine: 0
      branchChoice: []
    - text: "Kh\xE1ch n\xE0o ra c\u0169ng c\u01B0\u1EDDi t\u01B0\u01A1i."
      autoProgress: 0
      isInProgressLine: 0
      isCompletedLine: 0
      branchChoice: []
  - description: Winter
    minLevel: 0
    requiredSeason: 3
    startHour: 0
    endHour: 0
    startDate: 0
    quest: {fileID: 0}
    questDurationHours: 0
    dialogueLines:
    - text: "Tr\u1EDDi l\u1EA1nh qu\xE1, em c\u1EA7m b\xECnh tr\xE0 n\xF3ng m\xE0
        tay v\u1EABn c\u1EE9 run l\xEAn."
      autoProgress: 0
      isInProgressLine: 0
      isCompletedLine: 0
      branchChoice: []
    - text: "Tr\u1EDDi l\u1EA1nh qu\xE1, em c\u1EA7m b\xECnh tr\xE0 n\xF3ng m\xE0
        tay v\u1EABn c\u1EE9 run l\xEAn."
      autoProgress: 0
      isInProgressLine: 0
      isCompletedLine: 0
      branchChoice: []
    - text: "M\xE0 em c\xF3 \u0111an d\u1EDF c\xE1i g\u0103ng tay, anh xem th\u1EED
