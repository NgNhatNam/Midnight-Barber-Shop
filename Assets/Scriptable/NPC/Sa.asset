    startDate: 0
    quest: {fileID: 0}
    questDurationHours: 0
    dialogueLines:
    - text: "M\u01B0a xu\xE2n l\u1EA5m t\u1EA5m tr\xEAn m\u1EA5y nh\xE0nh hoa \u0111\xE0o
        tr\u01B0\u1EDBc qu\xE1n \u0111\u1EB9p qu\xE1 anh nh\u1EC9."
