    requiredSeason: 0
    startHour: 11
    endHour: 13
    startDate: 0
    quest: {fileID: 0}
    questDurationHours: 0
    dialogueLines:
    - text: "N\u1EAFng xu\xE2n nh\u1EB9 nh\xE0ng th\u1EADt, ch\u1EB3ng b\xF9 cho
